# Local API defaults to SQLite when DATABASE_URL is unset.
# Docker Compose sets DATABASE_URL to the included PostgreSQL service.
DATABASE_URL=sqlite:///./linepilot.db
API_INTERNAL_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000
AUTO_SEED=1
LINEPILOT_RUN_BACKEND=local
LINEPILOT_SOLVER_TIME_LIMIT_SECONDS=30
# Queue deployments use a shared CRON_SECRET on the private API and scheduler services.
# CRON_SECRET=
# Set a Monday to reproduce the published benchmark dataset exactly.
# DEMO_ANCHOR_DATE=2026-11-16
