{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "api",
          "format": "url",
          "env": "API_INTERNAL_URL"
        }
      ]
    },
    "api": {
      "root": "services/api",
      "framework": "fastapi",
      "entrypoint": "pyproject.toml",
      "functions": {
        "app/main.py": {
          "excludeFiles": "{tests/**,alembic/**,_uv/**}"
        },
        "app/queue_subscriber.py": {
          "excludeFiles": "{tests/**,alembic/**,_uv/**}"
        }
      }
    },
    "scheduler": {
      "root": "services/scheduler",
      "entrypoint": "api/reconcile.ts",
      "bindings": [
        {
          "type": "service",
          "service": "api",
          "format": "url",
          "env": "API_INTERNAL_URL"
        }
      ],
      "functions": {
        "api/reconcile.ts": {
          "experimentalTriggers": [{ "type": "schedule/v1beta" }]
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": { "service": "web" }
    }
  ],
  "schedules": {
    "reconcile-runs": {
      "schedule": "*/15 * * * *",
      "service": "scheduler",
      "function": "index"
    }
  }
}
